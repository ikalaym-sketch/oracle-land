{
  "ch": 11,
  "slots": [
    {
      "slot": "c11_m1:s0",
      "key": "",
      "lines": [
        {
          "who": "",
          "text": "（街上的門緊閉著，屋裡還有人低聲說話。）"
        },
        {
          "who": "蒼真",
          "text": "先挨戶問。別讓人連外頭還有誰都不知道。"
        },
        {
          "who": "小雪",
          "text": "我聽著。有人應聲，你就別急著走。"
        },
        {
          "who": "蒼真",
          "text": "妳也先別答應所有人，天一亮就能好。"
        },
        {
          "who": "小雪",
          "text": "我知道。我能說的是，我們還在這裡。"
        },
        {
          "who": "蒼真",
          "text": "這句就夠了。哪家缺藥，記下來告訴蓬庵。"
        },
        {
          "who": "小雪",
          "text": "蒼真，叫門前先報名字，免得嚇著人。"
        },
        {
          "who": "蒼真",
          "text": "我來敲。妳在旁邊，別一個人走進暗處。"
        },
        {
          "who": "白丸",
          "text": "……門關著，人還在。別只盯著熄掉的燈。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "有人不舒服就隔著門說，不必急著跑出來。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "聽見動靜再敲一次，怕的人未必敢立刻回答。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "我去看前一戶！這回不催他們快！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "人類，敲門別那麼重。裡頭還有孩子。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_m1:s0:spot0",
      "key": "外面好黑……柚吉在發燒。",
      "lines": [
        {
          "who": "梅乃婆婆",
          "text": "外面好黑……柚吉還在發燒，我不敢帶他出去。"
        },
        {
          "who": "蒼真",
          "text": "先關好門窗。我把孩子的情況告訴蓬庵。"
        },
        {
          "who": "梅乃婆婆",
          "text": "你們還在走動……我就不怕沒人聽見了。"
        },
        {
          "who": "小雪",
          "text": "婆婆，有事就叫。別一個人忍著不出聲。"
        },
        {
          "who": "汐音",
          "text": "先陪著柚吉，別讓他醒來只看見一片黑。",
          "cond": {
            "party": "shion"
          }
        }
      ]
    },
    {
      "slot": "c11_m1:s0:spot1",
      "key": "狐族的燈還亮著。我替你守著城東。",
      "lines": [
        {
          "who": "砂狐",
          "text": "狐族的燈還亮著。神社的大人，城東我守。"
        },
        {
          "who": "蒼真",
          "text": "貨先放著。有人想回家，給他照條路。"
        },
        {
          "who": "砂狐",
          "text": "這時候還談買賣，我自己都嫌難聽。燈不收錢。"
        },
        {
          "who": "葛葉",
          "text": "你也別只顧照別人，站得讓人看見。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "白丸",
          "text": "……記著這句。等天亮了，也別找人補燈錢。",
          "cond": {
            "party": "shiro"
          }
        }
      ]
    },
    {
      "slot": "c11_m1:s0:spot2",
      "key": "城交給我。……你去做你該做的事。",
      "lines": [
        {
          "who": "景綱",
          "text": "蒼真大人，城裡我守著。去查黃泉的源頭吧。"
        },
        {
          "who": "蒼真",
          "text": "別只守大門。屋裡還有人等著回話。"
        },
        {
          "who": "景綱",
          "text": "我記下了。有人敲門，城裡就得有人應。"
        },
        {
          "who": "颯",
          "text": "有消息就往後山送！別讓人以為全城沒聲了！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "城東也有人守。人類，別只數你自己的人。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_m1:s1",
      "key": "這裡……是亡者留下聲音的地方。",
      "lines": [
        {
          "who": "小雪",
          "text": "這裡……是亡者留下聲音的地方。"
        },
        {
          "who": "蒼真",
          "text": "妳等很久了？"
        },
        {
          "who": "小雪",
          "text": "剛到。我不想沒等你來，就自己聽完。"
        },
        {
          "who": "蒼真",
          "text": "那就從現在聽。聽見難受的，也能先停。"
        },
        {
          "who": "小雪",
          "text": "蒼真，這裡有些聲音，可能不只是在叫我們。"
        },
        {
          "who": "蒼真",
          "text": "先聽他說什麼，不急著答應。"
        },
        {
          "who": "小雪",
          "text": "我會聽完。那些人活著時，也有沒說完的話。"
        },
        {
          "who": "蒼真",
          "text": "妳要停就叫我。我不往前催。"
        },
        {
          "who": "白丸",
          "text": "……聽見熟人的聲音，也別一頭衝過去。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "我也想聽。可若只聽見一半，別替他補完。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "這次別忙著猜，安靜些反而聽得清。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "……我沒催。我也有想聽的聲音。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "聲音再輕也等他說完，活人先少搶幾句。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_m2:s0",
      "key": "",
      "lines": [
        {
          "who": "",
          "text": "（石室裡響著斷續的話音，有近有遠。）"
        },
        {
          "who": "蒼真",
          "text": "一處一處聽，別把幾個人的話混在一起。"
        },
        {
          "who": "小雪",
          "text": "也別只找認得的聲音。陌生人的話也想留下。"
        },
        {
          "who": "蒼真",
          "text": "妳怕聽見自己的名字？"
        },
        {
          "who": "小雪",
          "text": "怕。可我更怕只聽見器，連名字都沒了。"
        },
        {
          "who": "蒼真",
          "text": "那就把名字記清楚，不替任何人省掉。"
        },
        {
          "who": "小雪",
          "text": "蒼真，若我一時答不出話，你先別替我說。"
        },
        {
          "who": "蒼真",
          "text": "我等著。妳自己想好了再說。"
        },
        {
          "who": "白丸",
          "text": "……妳還站在這裡。別先把自己算進去。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "聽得難受，就先喘口氣。我們還有話能說。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "記得住多少就記多少，不必連沉默也猜透。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "這裡我不搶第一個。誰聽見，就先讓誰聽。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "人類，難聽的話也留著，別只挑好受的記。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_m2:s0:spot0",
      "key": "",
      "lines": [
        {
          "who": "回聲",
          "text": "「……我沒偷。」是權太的聲音。他死在牢裡。",
          "cond": {
            "choice": {
              "c5_truth": "silence"
            }
          }
        },
        {
          "who": "回聲",
          "text": "「三十年的火，總算交給下一代了。」是老爐守的聲音。",
          "cond": {
            "notchoice": {
              "c5_truth": "silence"
            }
          }
        },
        {
          "who": "蒼真",
          "text": "那時我沒開口。這回，不能再裝沒聽見。",
          "cond": {
            "choice": {
              "c5_truth": "silence"
            }
          }
        },
        {
          "who": "蒼真",
          "text": "他交出去的火，我會記著是誰守下來的。",
          "cond": {
            "notchoice": {
              "c5_truth": "silence"
            }
          }
        },
        {
          "who": "小雪",
          "text": "這些話，不能只留在石室裡。"
        }
      ]
    },
    {
      "slot": "c11_m2:s0:spot1",
      "key": "「師父不是叛徒……」——是颯師父的聲音。",
      "lines": [
        {
          "who": "回聲",
          "text": "「我不是叛徒……」是颯亡師留下的聲音。"
        },
        {
          "who": "蒼真",
          "text": "這句話，別再讓人傳成另一個意思。"
        },
        {
          "who": "小雪",
          "text": "我聽見了。不是叛徒，這幾個字不能省。"
        },
        {
          "who": "颯",
          "text": "……師父，我聽清楚了。這回一個字也不漏。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "蒼真",
          "text": "你想怎麼傳，我聽著。先把氣喘穩。",
          "cond": {
            "party": "hayate"
          }
        }
      ]
    },
    {
      "slot": "c11_m2:s0:spot2",
      "key": "「雪……對不起……」——是一個年輕男人的聲音。",
      "lines": [
        {
          "who": "",
          "text": "（年輕道摩留下的話，隔著三百年響起。）"
        },
        {
          "who": "回聲",
          "text": "雪……對不起……"
        },
        {
          "who": "小雪",
          "text": "是道摩的聲音。可他現在，還是想替人決定。"
        },
        {
          "who": "蒼真",
          "text": "聽見他後悔，不等於現在就得信他。"
        },
        {
          "who": "白丸",
          "text": "……三百年前沒說完的，現在倒讓別人來聽。",
          "cond": {
            "party": "shiro"
          }
        }
      ]
    },
    {
      "slot": "c11_m3:s0",
      "key": "",
      "lines": [
        {
          "who": "",
          "text": "（封印石已碎，小雪按住碎石，石縫透出微光。）"
        },
        {
          "who": "小雪",
          "text": "……還有最後一點力量。"
        },
        {
          "who": "蒼真",
          "text": "這些碎石還能用？"
        },
        {
          "who": "小雪",
          "text": "我要把它帶下去。黃泉的門，要用這個關上。"
        },
        {
          "who": "蒼真",
          "text": "我幫妳收。別每塊都自己拿。"
        },
        {
          "who": "小雪",
          "text": "它還在發光。我還有能做的事。"
        },
        {
          "who": "蒼真",
          "text": "那就帶著它。我清路，妳不用動手攔人。"
        },
        {
          "who": "小雪",
          "text": "不管發生什麼，你都會在我旁邊吧？",
          "cond": {
            "gte": {
              "xue": 4
            }
          }
        },
        {
          "who": "蒼真",
          "text": "會。妳叫我，我就回頭，不讓妳一個人。",
          "cond": {
            "gte": {
              "xue": 4
            }
          }
        },
        {
          "who": "小雪",
          "text": "……走吧。碎石收好了，門還等著關。",
          "cond": {
            "lt": {
              "xue": 4
            }
          }
        },
        {
          "who": "蒼真",
          "text": "妳走在我後頭。到了門前，再聽妳怎麼做。",
          "cond": {
            "lt": {
              "xue": 4
            }
          }
        },
        {
          "who": "白丸",
          "text": "……石頭沒撐住，不是妳沒守住。別認錯了。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "拿不動就說。碎石能分著拿，別磨破手。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "帶的是剩下的力量，不是叫妳連自己都耗光。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "碎石交給我拿也行！這回我不搶著跑前頭。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "小雪，妳要下去，我替妳開路，不替妳作主。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_m3:s1",
      "key": "",
      "lines": [
        {
          "who": "",
          "text": "（返程崖徑前，亡者的身影擋住了去路。）"
        },
        {
          "who": "蒼真",
          "text": "路被擋住了。小雪，碎石拿穩。"
        },
        {
          "who": "小雪",
          "text": "我收好了。蒼真，我跟在你後面，不進交手的地方。"
        },
        {
          "who": "蒼真",
          "text": "等我把路打開，再跟上來。"
        },
        {
          "who": "小雪",
          "text": "你回頭看見我，我才往前。這樣行不行？"
        },
        {
          "who": "蒼真",
          "text": "行。我不只喊妳跟上。"
        },
        {
          "who": "小雪",
          "text": "封印石碎成這樣，還得靠它關門……"
        },
        {
          "who": "蒼真",
          "text": "妳拿著它，我清路。別把兩件事全攬下。"
        },
        {
          "who": "白丸",
          "text": "……前頭打開了，後頭也得有人看。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "受傷就退回我看得見的地方，別悶著走。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "先認清誰站在哪裡，別被那些影子隔開。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "蒼真，我看前頭！這次叫你跟上，我會等！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "擋路的我來頂。人類，你別被逼到崖邊。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_m4:s0",
      "key": "（一位白衣的女神，被黑色的藤蔓纏住半身。）……你來了。新的器。",
      "lines": [
        {
          "who": "",
          "text": "（白衣女神站在門前，黑色藤蔓纏住半身。）"
        },
        {
          "who": "伊邪那美",
          "text": "……你來了，新的器。"
        },
        {
          "who": "小雪",
          "text": "我叫小雪。妳也是被叫作器的人？"
        },
        {
          "who": "伊邪那美",
          "text": "我是上上一代的器。……不，是最初的器。"
        },
        {
          "who": "蒼真",
          "text": "妳身上的那些東西，是大禍津日留下的？"
        },
        {
          "who": "伊邪那美",
          "text": "祂的污穢已經爬到我的心。我快撐不住了。"
        },
        {
          "who": "小雪",
          "text": "妳守著這扇門，卻沒有人來換妳？"
        },
        {
          "who": "伊邪那美",
          "text": "先別問了。淨化我，在我變成怪物之前。"
        },
        {
          "who": "蒼真",
          "text": "要救妳，就不能等藤蔓把妳整個吞掉。"
        },
        {
          "who": "小雪",
          "text": "我在門邊等。蒼真，別忘了她剛才還在說話。"
        },
        {
          "who": "蒼真",
          "text": "我記著。我們是來讓她能把話說完。"
        },
        {
          "who": "白丸",
          "text": "……不是來送下一個器，先把眼前這個救出來。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "她還能聽見。蒼真，別只看著那些藤蔓。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "她自己在求救，別把她和污穢算成一個。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "妳先撐著！我聽見了，這回不用再喊！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "還肯開口就別放手。這些黑的，我看著礙眼。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_s_relic:giver",
      "key": "老夫在舊冊的夾層裡找到一張地圖。",
      "lines": [
        {
          "who": "茂兵衛爺",
          "text": "舊冊夾層裡有張地圖，我差點當廢紙丟了。"
        },
        {
          "who": "蒼真",
          "text": "上頭標了哪裡？"
        },
        {
          "who": "茂兵衛爺",
          "text": "後山封印石下，埋著上一代巫女的遺物。"
        },
        {
          "who": "小雪",
          "text": "她留過東西？我想親眼看看。"
        },
        {
          "who": "茂兵衛爺",
          "text": "神社的大人，把圖帶著，別只憑老夫說的挖。"
        },
        {
          "who": "白丸",
          "text": "……舊冊裡有東西，這回總算沒漏掉。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "葛葉",
          "text": "別先猜她留了什麼，讓小雪自己打開看。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "圖收牢！後山風大，別剛找到又給吹走。",
          "cond": {
            "party": "hayate"
          }
        }
      ]
    },
    {
      "slot": "c11_s_relic:s0",
      "key": "（匣子裡是一支白色的花簪，和一封信。）",
      "lines": [
        {
          "who": "",
          "text": "（蒼真挖出匣子，裡面放著白色花簪和信。）"
        },
        {
          "who": "蒼真",
          "text": "「給下一個雪：不要當器。當你自己。」"
        },
        {
          "who": "小雪",
          "text": "她留了簪子，卻沒叫我接著當器。"
        },
        {
          "who": "蒼真",
          "text": "信是給妳的。要怎麼過，由妳自己選。"
        },
        {
          "who": "小雪",
          "text": "我想把它帶回去。這封信，我還要再看。"
        },
        {
          "who": "蒼真",
          "text": "先收進匣子，別讓信沾了土。"
        },
        {
          "who": "白丸",
          "text": "……這回留下來的，不是叫妳犧牲的話。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "妳想多看幾回就看，不用急著給誰答案。",
          "cond": {
            "party": "shion"
          }
        }
      ]
    },
    {
      "slot": "c11_s_souls:giver",
      "key": "黃泉的門開了，城裡多了很多……找不到路的人。",
      "lines": [
        {
          "who": "蓬庵",
          "text": "黃泉的門開了，城裡多了些找不到路的亡魂。"
        },
        {
          "who": "蒼真",
          "text": "這回不是送藥，是要送他們走？"
        },
        {
          "who": "蓬庵",
          "text": "是。老夫治得了病，治不了這個。"
        },
        {
          "who": "蒼真",
          "text": "你顧還活著的人。我去讓亡魂離開。"
        },
        {
          "who": "蓬庵",
          "text": "別把兩邊混在一起，屋裡還有人等藥。"
        },
        {
          "who": "汐音",
          "text": "要回家的人先進屋，別跟著街上的影子走。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "怕歸怕，也得先看清攔路的是誰。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "茨木童子",
          "text": "人類，別讓活人也擠到這條路上來。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_s_souls:s0",
      "key": "",
      "lines": [
        {
          "who": "",
          "text": "（街上的亡魂擋住去路，屋門一扇扇緊閉。）"
        },
        {
          "who": "蒼真",
          "text": "先清這條街，別讓亡魂堵到屋前。"
        },
        {
          "who": "小雪",
          "text": "我退到屋簷下，免得有人開門就撞上。"
        },
        {
          "who": "蒼真",
          "text": "妳留在那裡。有人出來，就叫他先回屋。"
        },
        {
          "who": "白丸",
          "text": "……看清腳下，別踩著活人的東西亂衝。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "蒼真，別追過轉角，我得看得見你。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "颯",
          "text": "屋前有人！往街中間走，別把路擠死！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "要開路就開寬點，別清一半又堵上。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_s_souls:s1",
      "key": "……他們走了。",
      "lines": [
        {
          "who": "蓬庵",
          "text": "……他們走了。剛才有個孩子對老夫揮手。"
        },
        {
          "who": "蒼真",
          "text": "你認得？"
        },
        {
          "who": "蓬庵",
          "text": "三十年前沒救回來的那個。老夫沒忘。"
        },
        {
          "who": "蒼真",
          "text": "你要再站一會兒，我等著。"
        },
        {
          "who": "蓬庵",
          "text": "不用。藥還沒分完，屋裡的人還在等。"
        },
        {
          "who": "蒼真",
          "text": "那你分藥，我把門前空出來。"
        },
        {
          "who": "汐音",
          "text": "想說他的事，晚些也能說，我們會聽。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "白丸",
          "text": "……記著就記著，誰也沒叫你趕快忘。",
          "cond": {
            "party": "shiro"
          }
        }
      ]
    },
    {
      "slot": "c11_s_yokai:giver",
      "key": "人類守城西，我們妖怪守城東。",
      "lines": [
        {
          "who": "狐族長者",
          "text": "人類守城西，我們妖怪守城東。"
        },
        {
          "who": "蒼真",
          "text": "城東的人都退開了？"
        },
        {
          "who": "狐族長者",
          "text": "還得有人看著入口。蒼真，陪我們撐這一波。"
        },
        {
          "who": "蒼真",
          "text": "我去入口。退路留著，別讓自己也出不來。"
        },
        {
          "who": "狐族長者",
          "text": "這回先守住城，不問躲在屋裡的是哪一族。"
        },
        {
          "who": "葛葉",
          "text": "人類肯守另一邊，我們也別只顧自己。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "白丸",
          "text": "……守的是城門，別回頭又拿人分兩邊。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "茨木童子",
          "text": "少看我的角，告訴我哪裡快擋不住。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_s_yokai:s0",
      "key": "",
      "lines": [
        {
          "who": "",
          "text": "（蒼真走到城東入口，望向守門的妖怪。）"
        },
        {
          "who": "蒼真",
          "text": "入口別堵滿，退下來的人也得有路走。"
        },
        {
          "who": "小雪",
          "text": "我留在後面，提醒想靠過來的人避開。"
        },
        {
          "who": "蒼真",
          "text": "站到牆邊。這波沒退，先別往入口走。"
        },
        {
          "who": "葛葉",
          "text": "守在這裡的，這次都算自己人。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "我看外頭！後面有人退，你們先讓路！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "汐音",
          "text": "撐不住就說，別等倒下才要人來找。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "茨木童子",
          "text": "人類，守完再吵誰站前頭。現在別分心。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "c11_after:s0",
      "key": "",
      "lines": [
        {
          "who": "",
          "text": "（藤蔓散去，女神的身影逐漸透明。）"
        },
        {
          "who": "伊邪那美",
          "text": "……謝謝。孩子，我把剩下的時間給妳。"
        },
        {
          "who": "小雪",
          "text": "妳也要消失了？"
        },
        {
          "who": "伊邪那美",
          "text": "「器歸無」是我寫的。可是，我寫錯了。"
        },
        {
          "who": "蒼真",
          "text": "哪裡錯？別讓她再照錯的走。"
        },
        {
          "who": "伊邪那美",
          "text": "器不必歸無。只要有人願意分擔，人和妖都可以。"
        },
        {
          "who": "伊邪那美",
          "text": "你身邊有很多妖怪的味道。……很好。",
          "cond": {
            "gte": {
              "bond": 2
            }
          }
        },
        {
          "who": "伊邪那美",
          "text": "你身邊，妖怪的味道還太少。得去問誰願意分擔。",
          "cond": {
            "lt": {
              "bond": 2
            }
          }
        },
        {
          "who": "蒼真",
          "text": "那就去問。先把她能活下去的辦法留下。"
        },
        {
          "who": "",
          "text": "（小雪抬起手，手指不再透明。）"
        },
        {
          "who": "小雪",
          "text": "蒼真，我的手……又看得清了。"
        },
        {
          "who": "白丸",
          "text": "……舊約也會寫錯，還讓她照著熬到現在！",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "小雪，先別再使力。讓我看看妳的手。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "多出來的時間，別又全花在等別人替妳選。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "要找誰就說名字。我能傳話，別把我漏掉！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "先聽清分擔要做什麼。我不白答應，也不會躲。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "xue_end:ch11",
      "key": "",
      "lines": [
        {
          "who": "",
          "text": "（回到神社，小雪把手伸到燈前看了又看。）"
        },
        {
          "who": "小雪",
          "text": "手不透明了。我還是怕一眨眼，又看不見。"
        },
        {
          "who": "蒼真",
          "text": "我也看著。今晚先別忙著藏起來。"
        },
        {
          "who": "小雪",
          "text": "她給我的是時間，不是說從此都不用怕了。"
        },
        {
          "who": "蒼真",
          "text": "那就拿這些時間找辦法，把肯幫忙的人找來。"
        },
        {
          "who": "小雪",
          "text": "人也好，妖也好。我想親口問他們願不願意。"
        },
        {
          "who": "蒼真",
          "text": "先問，不替誰答應，也不先替誰說不肯。"
        },
        {
          "who": "小雪",
          "text": "海邊我說要回家。現在，我還想繼續過下去。",
          "cond": {
            "choice": {
              "c10_xue": "ask"
            }
          }
        },
        {
          "who": "小雪",
          "text": "你在海邊替我拒絕了。接下來，也讓我自己問。",
          "cond": {
            "notchoice": {
              "c10_xue": "ask"
            }
          }
        },
        {
          "who": "小雪",
          "text": "封印石已經碎了，不能再照原來那樣補。"
        },
        {
          "who": "蒼真",
          "text": "我們從新知道的辦法試。明天先去敲門。"
        },
        {
          "who": "白丸",
          "text": "……別只敲遠處的。神社裡也有肯幫妳的。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "要我做什麼就問，別先把我的那份也背走。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "葛葉",
          "text": "誰說願意，也得讓他把代價聽清楚。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "颯",
          "text": "話我來傳！你們先想好，別省掉最要緊的！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "茨木童子",
          "text": "小雪，妳問妳的。我肯不肯，我自己答。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "xue_idle:ch11",
      "key": "",
      "lines": [
        {
          "who": "小雪",
          "text": "城裡一黑，我才知道，聽不見人聲也這麼可怕。"
        },
        {
          "who": "蒼真",
          "text": "想找人就喊名字。我聽見會回答。"
        },
        {
          "who": "小雪",
          "text": "我想安慰大家，卻又怕自己說了做不到的話。"
        },
        {
          "who": "蒼真",
          "text": "先說眼前能做的。妳也不用裝得不怕。"
        },
        {
          "who": "小雪",
          "text": "你剛才叫我，我答得太小聲了。再叫一次。"
        },
        {
          "who": "蒼真",
          "text": "小雪。這回不用急，等妳想答再答。"
        },
        {
          "who": "小雪",
          "text": "蠟滴到桌上了。你先別刮，連木頭都刮下來了。"
        },
        {
          "who": "蒼真",
          "text": "……這刀先收起來。桌子可不能少一角。"
        },
        {
          "who": "小雪",
          "text": "那張坐墊我曬了半天，你怎麼坐到地上去？"
        },
        {
          "who": "蒼真",
          "text": "想等妳先坐。等著等著，就坐下了。"
        },
        {
          "who": "小雪",
          "text": "你說話這麼少，走到哪裡都認得出你的腳步。"
        },
        {
          "who": "蒼真",
          "text": "那我不必故意踏重了。這雙鞋快磨穿了。"
        },
        {
          "who": "小雪",
          "text": "剛才我笑了一下，又覺得城裡的人還在怕。"
        },
        {
          "who": "蒼真",
          "text": "笑一下也能怕。沒誰要妳一直苦著臉。"
        },
        {
          "who": "小雪",
          "text": "我想把門口那塊鬆掉的木板換了。總是絆到。"
        },
        {
          "who": "蒼真",
          "text": "這件我記下。別等妳又踢一回才動手。"
        },
        {
          "who": "小雪",
          "text": "我想著回來後做什麼，會不會想得太遠？"
        },
        {
          "who": "蒼真",
          "text": "換木板、曬坐墊。這些都值得留到回來做。"
        },
        {
          "who": "小雪",
          "text": "一句對不起，原來也會讓人更難受。",
          "cond": {
            "done": "c11_m2"
          }
        },
        {
          "who": "蒼真",
          "text": "聽見他的過去，也不等於替他現在做的事點頭。",
          "cond": {
            "done": "c11_m2"
          }
        },
        {
          "who": "小雪",
          "text": "蓬庵記了那孩子三十年。我現在才知道。",
          "cond": {
            "done": "c11_s_souls"
          }
        },
        {
          "who": "蒼真",
          "text": "他肯說給我們聽，妳也不用急著勸他忘了。",
          "cond": {
            "done": "c11_s_souls"
          }
        },
        {
          "who": "小雪",
          "text": "那支花簪，我想挑自己喜歡的時候戴。",
          "cond": {
            "done": "c11_s_relic"
          }
        },
        {
          "who": "蒼真",
          "text": "挑好了叫我。我想看看妳自己選的樣子。",
          "cond": {
            "done": "c11_s_relic"
          }
        },
        {
          "who": "小雪",
          "text": "石頭碎了，我還是先想著，是不是我沒守好。",
          "cond": {
            "done": "c11_m3"
          }
        },
        {
          "who": "蒼真",
          "text": "妳守到現在了。別把所有人的錯都算給自己。",
          "cond": {
            "done": "c11_m3"
          }
        },
        {
          "who": "小雪",
          "text": "我看得清自己的手，還是忍不住反覆看。",
          "cond": {
            "done": "c11_after"
          }
        },
        {
          "who": "蒼真",
          "text": "想看就看。這回，讓自己高興一會兒。",
          "cond": {
            "done": "c11_after"
          }
        },
        {
          "who": "小雪",
          "text": "多出來的時間，我不想又全拿去等著消失。",
          "cond": {
            "done": "c11_after"
          }
        },
        {
          "who": "蒼真",
          "text": "那就把想做的事也算進去。我們還得找辦法。",
          "cond": {
            "done": "c11_after"
          }
        }
      ]
    },
    {
      "slot": "town_npc:ch11",
      "key": "",
      "lines": [
        {
          "who": "綾小路景綱",
          "text": "蒼真大人，能亮的燈先留在路口，別全搬進屋。"
        },
        {
          "who": "綾小路景綱",
          "text": "住戶少了誰，報名字，別只說有一個人不見了。"
        },
        {
          "who": "綾小路景綱",
          "text": "人和妖都在守城，誰來幫忙，我都會記著。"
        },
        {
          "who": "綾小路景綱",
          "text": "城東這一波守住了，我得讓城西也知道。",
          "cond": {
            "done": "c11_s_yokai"
          }
        },
        {
          "who": "綾小路景綱",
          "text": "居民肯回話了。我守城，你別再兩頭跑。",
          "cond": {
            "done": "c11_m1"
          }
        },
        {
          "who": "文也",
          "text": "蒼真大人，名冊先看名字，不要一見空格就劃掉。"
        },
        {
          "who": "文也",
          "text": "活著的人去哪裡避難，也得記，不只記門關著。"
        },
        {
          "who": "文也",
          "text": "我不敢把字寫小。怕有人拿著燈，還看錯家門。"
        },
        {
          "who": "文也",
          "text": "石室留下的話若要記，就照聽見的寫，別補猜想。",
          "cond": {
            "done": "c11_m2"
          }
        },
        {
          "who": "文也",
          "text": "上一代留下的信，請別只替她抄下器這個字。",
          "cond": {
            "done": "c11_s_relic"
          }
        },
        {
          "who": "巡檢孫六",
          "text": "神社的大人，敲門報名字，別讓人以為又來亡魂。"
        },
        {
          "who": "巡檢孫六",
          "text": "有人縮在門後不答話，別上去就踹門。"
        },
        {
          "who": "巡檢孫六",
          "text": "守哪扇門就先說好，別兩邊都以為有人守著。"
        },
        {
          "who": "巡檢孫六",
          "text": "東邊的妖怪守得住。要換人，也先跟人家說一聲。",
          "cond": {
            "done": "c11_s_yokai"
          }
        },
        {
          "who": "巡檢孫六",
          "text": "迷路的亡魂送走了，倒別把活人也攆回街上。",
          "cond": {
            "done": "c11_s_souls"
          }
        },
        {
          "who": "砂狐",
          "text": "神社的大人，燈下那點位置留給走路的人。"
        },
        {
          "who": "砂狐",
          "text": "怕歸怕，看清來人再關門，角可不都是來害人的。"
        },
        {
          "who": "砂狐",
          "text": "貨先擱著，人回來再算。我可不想對著空攤叫價。"
        },
        {
          "who": "砂狐",
          "text": "這回城東的人和妖都出力，功勞別只記一邊。",
          "cond": {
            "done": "c11_s_yokai"
          }
        },
        {
          "who": "砂狐",
          "text": "亡魂走了，剛才躲起來的人也能慢慢回攤子了。",
          "cond": {
            "done": "c11_s_souls"
          }
        },
        {
          "who": "花澄",
          "text": "神社的大人，今天我先不跳，免得踩到別人的燈。"
        },
        {
          "who": "花澄",
          "text": "手抖也能打拍子。跟不上，就先聽我拍。"
        },
        {
          "who": "花澄",
          "text": "不敢看門外的人，我陪他看著屋裡，不硬拉出去。"
        },
        {
          "who": "花澄",
          "text": "大家肯把門開一道縫了，我說話也不用喊破嗓子。",
          "cond": {
            "done": "c11_m1"
          }
        },
        {
          "who": "花澄",
          "text": "聽說有孩子向蓬庵揮手。他也很想回個招呼吧。",
          "cond": {
            "done": "c11_s_souls"
          }
        },
        {
          "who": "蓬庵",
          "text": "蒼真大人，來問病就說症狀，別只說臉色像鬼。"
        },
        {
          "who": "蓬庵",
          "text": "害怕不是丟臉的病，別逼人憋到一句也說不出。"
        },
        {
          "who": "蓬庵",
          "text": "我還看得清藥名。燈留著，別急著替我省那點油。"
        },
        {
          "who": "蓬庵",
          "text": "那孩子揮手的樣子，我記住了。這回別催我忘。",
          "cond": {
            "done": "c11_s_souls"
          }
        },
        {
          "who": "蓬庵",
          "text": "小雪的手恢復了，也先讓她歇，別圍著問個不停。",
          "cond": {
            "done": "c11_after"
          }
        },
        {
          "who": "茂兵衛爺",
          "text": "神社的大人，老夫記性還行，別把害怕當成糊塗。"
        },
        {
          "who": "茂兵衛爺",
          "text": "守著舊規矩久了，也得聽聽如今的人怎麼說。"
        },
        {
          "who": "茂兵衛爺",
          "text": "想問舊事就坐近些，別讓老夫扯著喉嚨講。"
        },
        {
          "who": "茂兵衛爺",
          "text": "信既然寫給下一個雪，就先讓小雪讀，別替她收走。",
          "cond": {
            "done": "c11_s_relic"
          }
        },
        {
          "who": "茂兵衛爺",
          "text": "聽說有人替小雪多留了些時間，那就別急著催她。",
          "cond": {
            "done": "c11_after"
          }
        }
      ]
    },
    {
      "slot": "party_talk:shiro:ch11",
      "key": "",
      "lines": [
        {
          "who": "白丸",
          "text": "……你蹲在門口做什麼？",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "蒼真",
          "text": "等小雪出來。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "白丸",
          "text": "她換件外衣，你倒擺出守城的樣子。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "蒼真",
          "text": "那我站起來。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "白丸",
          "text": "叫你別嚇人，沒叫你離開。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "蒼真",
          "text": "你也在這裡守半天。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "白丸",
          "text": "……我站慣了。跟你不一樣。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "蒼真",
          "text": "站累了，這回也能叫我。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "白丸",
          "text": "你少打瞌睡，就算幫忙了。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "蒼真",
          "text": "你叫一聲，我就醒。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "白丸",
          "text": "活訊石室裡叫得再像，也先看看是誰。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "白丸",
          "text": "返程崖徑上別只顧往前，後頭還有我們。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "白丸",
          "text": "黃泉吊橋再晃，你也別拿我的背當扶手。",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "白丸",
          "text": "黃泉之門前我守著。小雪想說的，得讓她說。",
          "cond": {
            "party": "shiro"
          }
        }
      ]
    },
    {
      "slot": "party_talk:shion:ch11",
      "key": "",
      "lines": [
        {
          "who": "汐音",
          "text": "蒼真，我剛才是不是又問你餓不餓？",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "蒼真",
          "text": "第三回。妳自己的飯還沒吃。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "汐音",
          "text": "我一緊張，就想先看看別人怎麼了。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "蒼真",
          "text": "那這回換我問。妳怎麼了？",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "汐音",
          "text": "……我怕沒聽清，人就不再說了。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "蒼真",
          "text": "我沒走。先把妳想說的接下去。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "汐音",
          "text": "我想坐在有人說話的地方。不是請你看著我。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "蒼真",
          "text": "那就坐著聊。先說飯裡要不要加鹽。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "汐音",
          "text": "不要。你也別一緊張，就替別人添滿。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "蒼真",
          "text": "鹽罐給妳。我這回只拿碗。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "汐音",
          "text": "活訊石室裡的聲音，我想坐下來慢慢聽。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "汐音",
          "text": "返程崖徑上我看著你，你也回頭看看我。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "汐音",
          "text": "黃泉吊橋走完，我想先歇一會兒。",
          "cond": {
            "party": "shion"
          }
        },
        {
          "who": "汐音",
          "text": "黃泉之門這麼近，還能聽見你說話就好。",
          "cond": {
            "party": "shion"
          }
        }
      ]
    },
    {
      "slot": "party_talk:kuzuha:ch11",
      "key": "",
      "lines": [
        {
          "who": "葛葉",
          "text": "你把燈往我這邊推，是嫌我話少？",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "蒼真",
          "text": "怕妳瞇著眼，還硬說自己看得清。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "葛葉",
          "text": "我看得清。你坐近點，也不會少塊肉。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "蒼真",
          "text": "那妳先把包袱挪開，給我留個位子。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "葛葉",
          "text": "……我還以為你不肯過來。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "蒼真",
          "text": "妳沒說，我哪知道這位置不是給包袱的。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "葛葉",
          "text": "我不說話，你就少猜我是不是生氣。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "蒼真",
          "text": "那妳真生氣時，要讓我聽得出來。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "葛葉",
          "text": "不用你教。小雪怕的時候，也別替她裝沒事。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "蒼真",
          "text": "她肯說，我會聽。妳也是。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "葛葉",
          "text": "活訊石室的話別替人補，聽見多少就留多少。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "葛葉",
          "text": "返程崖徑這麼窄，你先走。我看得見你。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "葛葉",
          "text": "黃泉吊橋上別拿沉默當答應，先問清楚。",
          "cond": {
            "party": "kuzuha"
          }
        },
        {
          "who": "葛葉",
          "text": "黃泉之門前，她有名字，別只跟著叫器。",
          "cond": {
            "party": "kuzuha"
          }
        }
      ]
    },
    {
      "slot": "party_talk:hayate:ch11",
      "key": "",
      "lines": [
        {
          "who": "颯",
          "text": "慢郎中，你今天怎麼不嫌我吵？",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "蒼真",
          "text": "沒叫你別說，只叫你別邊跑邊說。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "颯",
          "text": "我站著也能把話傳清楚！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "蒼真",
          "text": "那先把剛才吞掉的後半句補上。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "颯",
          "text": "……我想說，你要是怕，就告訴我。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "蒼真",
          "text": "怕。我還以為你不打算問。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "颯",
          "text": "我也怕。不是怕黑，是怕喊了沒人答。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "蒼真",
          "text": "那我走慢一點，讓你看見我。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "颯",
          "text": "別太慢！我說等你，可沒說要站一整晚。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "蒼真",
          "text": "聽見你催了，人還在。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "颯",
          "text": "活訊石室裡誰開口，我這次不搶話。",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "颯",
          "text": "返程崖徑的路我看著，回頭也會數人！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "颯",
          "text": "黃泉吊橋這次不比快，走到對面再吵！",
          "cond": {
            "party": "hayate"
          }
        },
        {
          "who": "颯",
          "text": "黃泉之門前，你說的話我會聽清，一句也不少。",
          "cond": {
            "party": "hayate"
          }
        }
      ]
    },
    {
      "slot": "party_talk:ibaraki:ch11",
      "key": "",
      "lines": [
        {
          "who": "茨木童子",
          "text": "人類，手別往我這邊伸。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "蒼真",
          "text": "妳的袖口勾在門上，越拉越緊。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "茨木童子",
          "text": "看見就說，我自己解。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "蒼真",
          "text": "我鬆開手了。門替妳扶著。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "茨木童子",
          "text": "……這種小事，我不用人幫。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "蒼真",
          "text": "我是在扶門，又沒替妳走路。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "茨木童子",
          "text": "你倒是很會挑話。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "蒼真",
          "text": "妳沒再罵，就當我挑對了。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "茨木童子",
          "text": "蒼真，回來後，這破門該修了。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "蒼真",
          "text": "妳指出哪裡卡，我來動手。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "茨木童子",
          "text": "活訊石室裡說話的，我不認得也會聽。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "茨木童子",
          "text": "返程崖徑別光盯著我的手，看前面的路。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "茨木童子",
          "text": "黃泉吊橋上別擠我。要跟就跟穩了。",
          "cond": {
            "party": "ibaraki"
          }
        },
        {
          "who": "茨木童子",
          "text": "黃泉之門前誰想拿小雪換路，先問我答不答應。",
          "cond": {
            "party": "ibaraki"
          }
        }
      ]
    },
    {
      "slot": "party_talk:yorimitsu:ch11",
      "key": "",
      "lines": []
    },
    {
      "slot": "party_talk:takemikazuchi:ch11",
      "key": "",
      "lines": []
    },
    {
      "slot": "party_talk:enno:ch11",
      "key": "",
      "lines": []
    },
    {
      "slot": "52_hub:L128",
      "key": "（天，整個暗了。城裡的燈一盞一盞熄滅。）",
      "lines": [
        {
          "who": "",
          "text": "（天色整個暗下來，城裡的燈接連熄滅。）"
        },
        {
          "who": "小雪",
          "text": "黃泉之氣漫出來了。後山的封印石撐不住了。"
        },
        {
          "who": "蒼真",
          "text": "先讓居民進屋，別留在街上。"
        },
        {
          "who": "小雪",
          "text": "蒼真，這一次，我必須跟你一起下去。"
        },
        {
          "who": "蒼真",
          "text": "太危險。妳的手之前已經開始透明了。"
        },
        {
          "who": "小雪",
          "text": "我知道。可是黃泉的門，只有器打得開。"
        },
        {
          "who": "小雪",
          "text": "也只有器關得上。我留在這裡，門不會自己關。"
        },
        {
          "who": "蒼真",
          "text": "妳之前不說，是怕我反對？"
        },
        {
          "who": "小雪",
          "text": "我就是怕。所以這次要當著你的面說清楚。"
        },
        {
          "who": "蒼真",
          "text": "我聽見了。城裡安頓好，我陪妳下去。"
        },
        {
          "who": "小雪",
          "text": "哪裡走不動，我會告訴你，不自己硬撐。"
        },
        {
          "who": "白丸",
          "text": "……整座城都是死人的味道。活人先躲好！",
          "cond": {
            "party": "shiro"
          }
        },
        {
          "who": "汐音",
          "text": "小雪，害怕也能說。別只報哪裡不舒服。",
          "cond": {
            "party": "shion"
